{
  "name": "pro-vision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm test --prefix competition-app",
    "build": "npm run build --prefix competition-app",
    "build:pages": "node scripts/build.mjs && node scripts/pages.mjs",
    "dev": "node --env-file-if-exists=.env competition-app/scripts/dev.mjs",
    "dev:ai": "node --env-file-if-exists=.env competition-app/scripts/dev.mjs --foundry",
    "ai:setup": "node node_modules/foundry-local-sdk/script/install-native.cjs",
    "build:offline": "node scripts/offline.mjs",
    "preview:ai": "node scripts/local-ai-preview.mjs",
    "doctor": "node scripts/doctor.mjs",
    "legacy:dev": "node --env-file-if-exists=.env server.mjs",
    "legacy:dev:ai": "node --env-file-if-exists=.env server.mjs --ai",
    "legacy:build": "node scripts/build.mjs",
    "legacy:test": "node --test tests/*.test.mjs",
    "legacy:build:pages": "node scripts/build.mjs && node scripts/pages.mjs",
    "legacy:build:offline": "node scripts/offline.mjs",
    "start": "node competition-app/scripts/dev.mjs",
    "validate": "npm run validate --prefix competition-app"
  },
  "devDependencies": {
    "foundry-local-sdk": "2.1.0"
  }
}
