{
  "name": "pro-vision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs && node scripts/pages.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "dev:ai": "node --env-file-if-exists=.env server.mjs --ai",
    "ai:setup": "node node_modules/foundry-local-sdk/script/install-native.cjs",
    "build:offline": "node scripts/offline.mjs"
  },
  "devDependencies": {
    "foundry-local-sdk": "2.1.0"
  }
}
