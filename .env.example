# Optional Azure adapter. Keep actual values in ignored .env.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Hosted deployment only: HTTPS address serving both app and API.
PUBLIC_ORIGIN=
# Local default stays loopback. Hosting supplies HOST=0.0.0.0 and PORT.

# Counts real hosted model attempts, including repairs and failures.
# Per-process safeguard, not a billing cap; resets on process restart.
PROVISION_AI_DAILY_LIMIT=100
